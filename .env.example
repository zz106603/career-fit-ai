# Copy this file to .env for Docker Compose. Spring Boot does not load it automatically.
DB_PASSWORD=change-me
POSTGRES_DB=career_fit
POSTGRES_USER=career_fit
POSTGRES_PORT=5432

# Copy these values to a separate IntelliJ Spring Boot/Gradle run configuration when needed.
AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT=30s
OPENAI_MAX_OUTPUT_TOKENS=500
ASYNC_DISPATCHER_ENABLED=false
ASYNC_DISPATCHER_FIXED_DELAY=5s
ASYNC_DISPATCHER_BATCH_SIZE=10
